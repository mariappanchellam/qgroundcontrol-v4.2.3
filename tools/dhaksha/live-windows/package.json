{
  "name": "dhaksha-live",
  "productName": "Dhaksha Live",
  "version": "2.0.0",
  "description": "Watch up to eight Dhaksha drone streams from Livepush at once",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.dhaksha.live",
    "productName": "Dhaksha Live",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "DhakshaLive-${version}.exe"
    }
  }
}
