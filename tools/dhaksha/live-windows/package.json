{
  "name": "dhaksha-live",
  "productName": "Dhaksha Live",
  "version": "3.1.0",
  "description": "Watch up to 25 Dhaksha drone streams at once from the Dhaksha video server or Livepush",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:linux32": "electron-builder --linux --ia32 --publish never -c.electronVersion=18.3.15"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.dhaksha.live",
    "productName": "Dhaksha Live",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "DhakshaLive-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "icon": "resources/icon.png",
      "category": "Video",
      "executableName": "dhaksha-live",
      "maintainer": "Dhaksha",
      "synopsis": "Watch Dhaksha drone streams from Livepush",
      "artifactName": "DhakshaLive-${version}-linux-${arch}.${ext}"
    },
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dhaksha Live",
      "uninstallDisplayName": "Dhaksha Live",
      "artifactName": "DhakshaLive-Setup-${version}.exe"
    },
    "publish": null
  },
  "author": {
    "name": "Dhaksha"
  },
  "homepage": "https://github.com/mariappanchellam/qgroundcontrol-v4.2.3",
  "dependencies": {
    "hls.js": "1.5.20"
  }
}
